extends include/layout.pug
include include/mixins.pug
block append properties
    -
        var title = "SmarkForm Empty Template";
        var description = "A blank SmarkForm starter form with import, export and clear triggers, ready to customize with your own fields.";
block mainForm
    section
        div Do your magic here... 😉
    section
        .form-group
            .spacer
            button(data-smark = {
                action: "clear",
            }, title="Clear form data") ❌ Cancel
            button(data-smark = {
                action: "export",
            }, title="Submit form data") 💾 Submit
